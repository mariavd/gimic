# This jobscript takes three arguments:
# $1 is the working directory of the calculation (contains gimic.inp)
# $2 is the number of OpenMP threads
# $3 is the profile type: current (default), vertical or squares

function checkIfEmpty() {
local __inputVar=$1
local __inputValue="$2"
while [ -z "$__inputValue" ]
do
    printf "*** Variable \"$__inputVar\" empty ***\nPlease restart the script.\n"
    echo "If the error persists, file a bug report to maria.dimitrova@helsinki.fi or https://github.com/mariavd/gimic"; echo
    exit;
done
}

echo "SLURM_JOB_ID is" $SLURM_JOB_ID
echo
echo "Current profile calculation"

module load gimic

wrkdir=$( echo $1 )
checkIfEmpty wrkdir $wrkdir

dirname=$( echo ${wrkdir##*/} ) # removes everything before the backslash
checkIfEmpty dirname $dirname

parallel=$2
checkIfEmpty parallel $parallel
profileMode=${3:-current}

# GIMIC runs in parallel with OpenMP over the columns of the integration
# grid; the launcher keeps BLAS single-threaded.
export OMP_NUM_THREADS=$parallel

# clean up possible previous results (only inside the work directory)
rm -f "$wrkdir"/GIMIC.* "$wrkdir"/*.eps "$wrkdir"/current_profile.dat "$wrkdir"/profile.dat "$wrkdir"/squares_profile.dat

date
echo "Running GIMIC with $parallel threads..."; echo
cd $wrkdir && gimic gimic.inp > gimic.out
date
grep "Induced current (nA/T)" $wrkdir/gimic.out
echo

###################################################################################

if [ "$profileMode" == "current" ] && [ -f $wrkdir/current_profile.dat ]
then
    # Plot the profile and find the zeroes
    @SCRIPTS_DIR@/crit_pts.sh $wrkdir
fi

#######################################################################

# print some info like used time, disk, reserved memory and actual used memory
sacct -j $SLURM_JOB_ID --format=jobid,jobname,AllocNodes,AllocCPUs,CPUTime,MaxDiskRead,MaxDiskWrite

echo
