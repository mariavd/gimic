#!/bin/bash

# Function definitions:
source  @SCRIPTS_DIR@/src/functions-def

echo "Resubmit a current profile calculation (run from the profile directory)"

wrkdir=$(pwd)
checkIfEmpty wrkdir $wrkdir
dirname=$( echo ${wrkdir##*/} ) # removes everything before the backslash
checkIfEmpty dirname $dirname

if [ ! -f $wrkdir/gimic.inp ]
then
    echo "No gimic.inp in $wrkdir"
    exit 1
fi

echo "Working directory:"; echo $wrkdir; echo

profileMode=current
case $dirname in
    vertical_profile*) profileMode=vertical ;;
    squares_profile*)  profileMode=squares ;;
esac

parallel=16
echo "Number of OpenMP threads (cores of one node) for the GIMIC run"
read parallel
checkIfEmpty parallel $parallel

echo "Enter the time limit for the execution of the batch job in hours"
read duration
checkIfEmpty duration $duration

sbatch --ntasks=1 --cpus-per-task="$parallel" --job-name="$dirname" --time="$duration":00:00 @SCRIPTS_DIR@/jobscript "$wrkdir" "$parallel" "$profileMode"
echo
