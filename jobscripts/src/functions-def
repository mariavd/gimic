function A2bohr() { for val in $@; do awk -v a=$val 'BEGIN{ bohr=1.88971616463207; print a*bohr; }'; done; };

function bohr2A() { for val in $@; do awk -v a=$val 'BEGIN{ bohr=0.5291772490; print a*bohr; }'; done; };


# Geometry related functions:
function centroid() { atoms="$@"; for i in $atoms; do awk -v i=$i '{ if (NR == i+1) print $0 }' coord; done | awk '{ x+=$1; y+=$2; z+=$3; n++} END{ print x/n, y/n, z/n; }'; }

function halfDistance() { awk -v a1="$1" -v a2="$2" '{ if (NR == a1+1) { x+=$1;y+=$2;z+=$3;}; if (NR == a2+1) {x-=$1;y-=$2;z-=$3} } END{ dist=sqrt(x*x+y*y+z*z); print dist*0.5; }' coord ; }

function calcDistance() { awk -v a1="$1" -v a2="$2" '{ if (NR == a1+1) { x+=$1;y+=$2;z+=$3;}; if (NR == a2+1) {x-=$1;y-=$2;z-=$3} } END{ dist=sqrt(x*x+y*y+z*z); print dist; }' coord ; }


function point_dist() 
{
    # usage: echo $x0A $x1A | point_dist 
awk '{
     split($0,crd);
     dx=crd[1]-crd[4]; 
     dy=crd[2]-crd[5]; 
     dz=crd[3]-crd[6]; 
     dist=sqrt(dx*dx + dy*dy + dz*dz);
     print dist; }'
};


function angle() 
{
    # usage: echo  $x0 $x1 | angle 
    awk '{
         split($0,crd); 
	 dx=crd[1]-crd[4]; 
	 dy=crd[2]-crd[5]; 
	 dz=crd[3]-crd[6]; 

	 alpha=atan2(dy, dx); print alpha;

     }'
 };


function planeNormal()
{
# usage: planeNormal atom1 atom2 atom3 ...
# Unit normal of the mean plane through the atoms (bohr, from coord): the sum
# of the cross products of consecutive centroid-relative position vectors. The
# sign is chosen like the default field (0, 0, -1): z component negative, or
# the largest component negative when the plane contains the z axis.
    for i in "$@"; do awk -v i=$i '{ if (NR == i+1) print $1, $2, $3 }' coord; done | awk '
        { n++; x[n]=$1; y[n]=$2; z[n]=$3; cx+=$1; cy+=$2; cz+=$3 }
        END {
            if (n < 3) { print ""; exit }
            cx/=n; cy/=n; cz/=n;
            for (i=1; i<=n; i++) {
                j = (i % n) + 1;
                ax=x[i]-cx; ay=y[i]-cy; az=z[i]-cz; bx=x[j]-cx; by=y[j]-cy; bz=z[j]-cz;
                nx += ay*bz - az*by; ny += az*bx - ax*bz; nz += ax*by - ay*bx;
            }
            l = sqrt(nx*nx + ny*ny + nz*nz);
            if (l < 1e-8) { print ""; exit }
            nx/=l; ny/=l; nz/=l;
            big = nz; if (nx*nx > big*big) big = nx; if (ny*ny > big*big) big = ny;
            if (nz*nz < 1e-12) { if (big > 0) { nx=-nx; ny=-ny; nz=-nz } }
            else if (nz > 0) { nx=-nx; ny=-ny; nz=-nz }
            printf("%.6f %.6f %.6f\n", nx, ny, nz);
        }'
}

function readParameter()
{
# usage: readParameter variable $dirname 
    local __inputVar=$1
    dirname="$2"
    sedstring=$( echo 's/^.*'$__inputVar'=//p'  )
     __inputValue=$( sed -n -e $sedstring $dirname/calculation.dat | awk '{print $1}')
    eval $__inputVar="'$__inputValue'"
}

