function normalPlane() 
{
# usage: 
# echo $x0 $x1 $x2 | normalPlane
# where the coordinates are in bohr
# take the coordinates of x0 and x1
# define the point C with coords the third point from the plane
# define vector a: C -> x0; vector b: C -> x1;
# calculate their cross product to find the normal vector to the plane at point C

    awk '{
          split($0,crd);

          cx = crd[7]; 
          cy = crd[8]; 
          cz = crd[9]; 

          ax = cx - crd[1]; 
          ay = cy - crd[2];
          az = cz - crd[3];

          bx = cx - crd[4]; 
          by = cy - crd[5];
          bz = cz - crd[6];

          nx = -ay*bz + az*by ; 
          ny = -az*bx + ax*bz ;
          nz = -ax*by + ay*by ;

          nmod=sqrt(nx*nx + ny*ny + nz*nz); 
          print nx/nmod, ny/nmod, nz/nmod; 
    }'
};


function dotProduct() {
# usage: 
# echo $x0 $x1 | dotProduct
    awk '{
          split($0,crd);
	dot = crd[1]*crd[4] + crd[2]*crd[5] + crd[3]*crd[6]
	print dot;
    }'
}


###############################################################################
# Fixed point and orientation of the integration plane
#
# GIMIC (src/fgimic/grid.f90, setup_bond_grid) builds the plane from the two
# bond atoms A1, A2 and the fixed point F:
#     d  = A2 - A1                 normal of the integration plane (bond direction)
#     n  = (A1 - F) x (A2 - F)     normal of the plane (A1, A2, F); the "up" axis of the grid is -n
#     in = n x d                   direction in which the first component of "width" is measured
# The plane is therefore always perpendicular to the bond, whatever F is. F only
# decides on which side of the bond the integration starts: F must lie on the
# same side as the point the integration starts from (e.g. the ring centre).
# The integrated current is the flux of J along d. With an explicit magnetic
# field B it is positive for a diatropic current only if B.n > 0 (verified
# numerically on benzene, see doc/current-profile-port-plan.md). Otherwise the
# bond direction is reversed in the GIMIC input (bond=[A2,A1]), which changes
# only the sign, not the position of the plane.

function fixPointAndOrientation() {
# usage: fixPointAndOrientation atom1 atom2 Bx By Bz [Cx Cy Cz]
# Prints "Fx Fy Fz swap" where F is the fixed point (bohr) and swap=1 means that
# the bond direction must be reversed. F is the point C if given (it must not
# lie on the bond axis), otherwise the bond midpoint displaced by 1 bohr along
# B x d, i.e. within the plane perpendicular to B.
    awk -v a1="$1" -v a2="$2" -v Bx="$3" -v By="$4" -v Bz="$5" -v Cx="$6" -v Cy="$7" -v Cz="$8" '
    function cross(ax,ay,az, bx,by,bz) { cx = ay*bz - az*by; cy = az*bx - ax*bz; cz = ax*by - ay*bx }
    NR == a1+1 { A1x=$1; A1y=$2; A1z=$3 }
    NR == a2+1 { A2x=$1; A2y=$2; A2z=$3 }
    END {
        dx = A2x-A1x; dy = A2y-A1y; dz = A2z-A1z; dl = sqrt(dx*dx+dy*dy+dz*dz);
        Mx = 0.5*(A1x+A2x); My = 0.5*(A1y+A2y); Mz = 0.5*(A1z+A2z);
        nl = 0;
        if (Cx != "" && Cy != "" && Cz != "") {
            Fx = Cx; Fy = Cy; Fz = Cz;
            cross(A1x-Fx, A1y-Fy, A1z-Fz, A2x-Fx, A2y-Fy, A2z-Fz); nl = sqrt(cx*cx+cy*cy+cz*cz);
        }
        if (nl < 1e-6*dl*dl) {   # no centre given, or it lies on the bond axis
            cross(Bx,By,Bz, dx,dy,dz); ul = sqrt(cx*cx+cy*cy+cz*cz);
            if (ul < 1e-8*dl) { cross(dx,dy,dz, 1,0,0); ul = sqrt(cx*cx+cy*cy+cz*cz); }
            if (ul < 1e-8*dl) { cross(dx,dy,dz, 0,1,0); ul = sqrt(cx*cx+cy*cy+cz*cz); }
            Fx = Mx + cx/ul; Fy = My + cy/ul; Fz = Mz + cz/ul;
            cross(A1x-Fx, A1y-Fy, A1z-Fz, A2x-Fx, A2y-Fy, A2z-Fz);
        }
        swap = (Bx*cx + By*cy + Bz*cz < 0) ? 1 : 0;
        printf("%.6f %.6f %.6f %d\n", Fx, Fy, Fz, swap);
    }' coord
}

function setFixPoint() {
# usage: setFixPoint Bx By Bz
# Uses atom1, atom2 and the centroid inCx inCy inCz of the atoms defining the
# start of the integration (may be empty). Sets Fx Fy Fz: the reference
# centre written as towards_coord to the GIMIC input. GIMIC uses it as the
# fixed point of the plane and orients the plane normal such that diatropic
# currents are positive, so the order of the bond atoms does not matter.
    read Fx Fy Fz swapBond <<< "$(fixPointAndOrientation $atom1 $atom2 $1 $2 $3 $inCx $inCy $inCz)"
    checkIfEmpty Fx $Fx
    checkIfEmpty Fy $Fy
    checkIfEmpty Fz $Fz
    echo "Reference centre / fixed point: ($Fx; $Fy; $Fz)"
    if [ ! -z "$inCx" ]
    then
        echo "(centroid of the atoms that define the start of the integration)"
    else
        echo "(bond midpoint displaced by 1 bohr along B x bond; enter atom indices for the"
        echo " start of the integration to use their centroid instead)"
    fi
}

function planeCheck() {
# usage: planeCheck
# Dry run of the whole-plane input in $dirname: prints the grid size and the
# slices, writes grid.xyz (molecule, the four corners of the plane, and the
# field direction as a Be atom) for inspection.
    printf "\nPerforming a dry run...\n\n"
    (cd ./$dirname/ && gimic --dryrun gimic.inp | grep -i "slices\|grid points\|reference centre\|error\|warn" )
    printf "\n"
}
