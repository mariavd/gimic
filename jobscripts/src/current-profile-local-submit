
# Run the calculation: one GIMIC run over the whole plane, parallel with
# OpenMP over the columns of the grid.

wrkdir=$(pwd)
wrkdir=$(echo $wrkdir/$dirname)
echo "Working directory:"; echo $wrkdir; echo
checkIfEmpty wrkdir $wrkdir

ncores=$(nproc 2>/dev/null || echo 4)
parallel=$ncores
echo "Number of OpenMP threads for the GIMIC run"
valueDimInp parallel $parallel "threads"
checkIfEmpty parallel $parallel
echo threads=$parallel >> $wrkdir/calculation.dat

# clean up results of a possible previous calculation (only inside the work directory)
rm -f "$wrkdir"/GIMIC.* "$wrkdir"/*.eps "$wrkdir"/current_profile.dat "$wrkdir"/profile.dat "$wrkdir"/squares_profile.dat

date
echo "Running GIMIC with $parallel threads (progress is reported on the terminal)..."; echo
(cd $wrkdir && OMP_NUM_THREADS=$parallel gimic gimic.inp > gimic.out)
date
grep "Induced current (nA/T)" $wrkdir/gimic.out
echo

if [ ! -f $wrkdir/profile.dat ]
then
    echo "No profile was written; see $wrkdir/gimic.out"
    exit 1
fi

###################################################################################

if [ "$profileMode" == "current" ]
then
    # Plot the profile and find the zeroes
    (cd $wrkdir && @SCRIPTS_DIR@/crit_pts.sh > profile-points.out )
    cat $wrkdir/profile-points.out
else
    echo "Results in $wrkdir:"
    ls $wrkdir/*profile*.dat
fi

###################################################################################

echo
