
# Submit the calculation: one GIMIC run over the whole plane, parallel with
# OpenMP over the columns of the grid.

wrkdir=$(pwd)
wrkdir=$(echo $wrkdir/$dirname)
echo "Working directory:"; echo $wrkdir; echo

parallel=16
echo "Number of OpenMP threads (cores of one node) for the GIMIC run"
valueDimInp parallel $parallel "threads"
checkIfEmpty parallel $parallel
echo threads=$parallel >> $wrkdir/calculation.dat

# job duration:
duration=12
echo "Enter the time limit for the execution of the batch job in hours"
valueDimInp duration $duration "hours"
checkIfEmpty duration $duration

sbatch --ntasks=1 --cpus-per-task="$parallel" --job-name="$dirname" --time="$duration":00:00 @SCRIPTS_DIR@/jobscript "$wrkdir" "$parallel" "$profileMode"
echo
