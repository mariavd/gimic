# Cyclooctatetraene in its tub form (D2d), BP86/def2-SVP: a non-planar ring.
# Current through the double bond C1=C3, from the S4 axis outwards, split into
# its diatropic and paratropic parts by following streamlines.
calc=integral
title=""
basis="MOL"
xdens="XDENS"
debug=1
openshell=false
magnet=[0.0, 0.0, -1.0]     # along the S4 axis

Grid(bond) {
    type=gauss
    bond=[1,3]
    fixpoint=7
    distance=1.271
    gauss_order=9
    grid_points=[30, 30, 0]
    height=[-6.0, 6.0]
    width=[-2.96, 6.0]
}

Advanced {
    spherical=off
    screening=on
    screening_thrs=1.d-8
}

Essential {
    tropicity=on
}
