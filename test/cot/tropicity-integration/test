#!/usr/bin/env python3

import os
import sys
sys.path.append(os.path.join(os.path.dirname(__file__), '..', '..'))

from runtest import version_info, get_filter, cli, run
from runtest_config import configure

assert version_info.major == 2

options = cli()

f = [
    get_filter(from_string='Induced current (au)',
               num_lines=3,
               rel_tolerance=1.0e-8),
    # Near the carbon framework diatropic and paratropic streamlines lie
    # close together, so that a few quadrature points can change label with
    # the compiler or the BLAS library. Check the split in nA/T (the second
    # number of each line) to 0.05 nA/T; it is about 2.56 and -6.95 nA/T.
    get_filter(from_string='Split by tropicity',
               num_lines=4,
               mask=[2],
               abs_tolerance=5.0e-2),
]

ierr = run(options,
           configure,
           input_files=['gimic.inp'],
           filters={'stdout': f})

sys.exit(ierr)
