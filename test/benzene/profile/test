#!/usr/bin/env python3

import os
import sys
sys.path.append(os.path.join(os.path.dirname(__file__), '..', '..'))

from runtest import version_info, get_filter, cli, run
from runtest_config import configure

assert version_info.major == 2

options = cli()

f = {
    'stdout': [get_filter(from_string=' *** Integrating current',
                          num_lines=10,
                          rel_tolerance=1.0e-8)],
    'current_profile.dat': [get_filter(abs_tolerance=1.0e-6)],
    'profile.dat': [get_filter(abs_tolerance=1.0e-6)],
}

ierr = run(options,
           configure,
           input_files=['gimic.inp'],
           filters=f)

sys.exit(ierr)
