# Current profile across the benzene bond 1-2 from the ring centre outwards,
# computed in one run: one Gauss block per slice.

calc=integral
title=""
basis="MOL"
xdens="XDENS"
debug=1
openshell=false
magnet=[0.0, 0.0, -1.0]

Grid(bond) {
    type=gauss
    bond=[1,2]
    towards=[1,2,3,4,5,6]    # ring centre: fixed point and sign convention
    distance=1.3147
    gauss_order=9
    grid_points=[72, 0, 0]   # the width is set by the slices
    height=[-8.0, 8.0]
    width=[-2.6, 8.0]
    slices=[0.2, 0.0]        # 53 slices of 0.2 bohr along the width
}

Advanced {
    lip_order=5
    spherical=off
    diamag=on
    paramag=on
    GIAO=on
    screening=on
    screening_thrs=1.d-8
}
