# Current density of benzene on a coarse 3D grid, split by tropicity. Only a
# part of the grid points is followed; the others take the label of a
# streamline that passes them (Tropicity.capture, on by default).
calc=cdens
title=""
basis="MOL"
xdens="XDENS"
debug=1
openshell=false
magnet=[0.0, 0.0, 1.0]

Grid(base) {
    type=even
    origin=[-6.0, -6.0, -3.0]
    ivec=[1.0, 0.0, 0.0]
    jvec=[0.0, 1.0, 0.0]
    lengths=[12.0, 12.0, 6.0]
    grid_points=[21, 21, 11]
}

Advanced {
    spherical=off
    screening=on
    screening_thrs=1.d-8
}

Essential {
    tropicity=on
}
