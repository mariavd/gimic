#!/usr/bin/env python3

import os
import sys
sys.path.append(os.path.join(os.path.dirname(__file__), '..', '..'))

from runtest import version_info, get_filter, cli, run
from runtest_config import configure

assert version_info.major == 2

options = cli()

# A grid point takes the label of a streamline that passes within a given
# distance of it, so a point at that distance can change label with the
# compiler or the BLAS library. Check the share of each label (the second
# number of each line, in per cent) to one percentage point.
f = [
    get_filter(from_string='Tropicity assigned by streamline tracing',
               num_lines=4,
               mask=[2],
               abs_tolerance=1.0),
]

ierr = run(options,
           configure,
           input_files=['gimic.inp'],
           filters={'stdout': f})

sys.exit(ierr)
