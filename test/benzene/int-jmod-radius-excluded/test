#!/usr/bin/env python3

import os
import sys
sys.path.append(os.path.join(os.path.dirname(__file__), '..', '..'))

from runtest import version_info, get_filter, cli, run
from runtest_config import configure

assert version_info.major == 2

options = cli()

# every grid point lies outside the radius: all integrals and their
# positive and negative parts must be exactly zero (absolute tolerance,
# since the reference values are zero)
f = [
    get_filter(from_string=' *** Integrating |J|',
               num_lines=11,
               abs_tolerance=1.0e-12),
    get_filter(from_string=' *** Integrating current',
               num_lines=10,
               abs_tolerance=1.0e-12),
]

ierr = run(options,
           configure,
           input_files=['gimic.inp'],
           filters={'stdout': f})

sys.exit(ierr)
