import os

GIMIC_EXECUTABLE = '@CMAKE_INSTALL_FULL_BINDIR@/gimic.bin'

class GimicDriver:
    def __init__(self, args, inkeys):
        self.args = args
        self.kw = inkeys

    def run(self):
        print("This is F-GIMIC.")

        infile='GIMIC.in' + str(os.getpid())
        fd=open(infile,'w')
        fd.write(str(self.kw))

        fd.close()

        # launcher can be e.g. "mpirun -np 4" or "valgrind", etc.
        launcher = os.getenv('GIMIC_LAUNCHER', '')

        # GIMIC parallelizes over grid points with OpenMP and calls BLAS
        # from inside the parallel region; a threaded BLAS on top of that
        # oversubscribes the cores badly. Keep BLAS single-threaded unless
        # the user has chosen otherwise.
        for var in ('OPENBLAS_NUM_THREADS', 'MKL_NUM_THREADS', 'BLIS_NUM_THREADS'):
            os.environ.setdefault(var, '1')

        command = '{0} {1} < {2}'.format(launcher, GIMIC_EXECUTABLE, infile)
        os.system(command)

        os.unlink(infile)

